{
  // Basic
  "name": "TestProject Dev Container",
  // Auth/API keys: follow Anthropic and OpenAI official docs; never commit secrets. Use local-only remoteEnv overrides if needed.
  "dockerComposeFile": [
    "docker-compose.dev.yml",
    "docker-compose.search.yml",
    "docker-compose.db.yml",
    "docker-compose.message.yml",
    "docker-compose.cypress.yml"
  ],
  "service": "workspace",
  // "runServices": ["workspace", "postgres", "redis", "elasticsearch", "kibana", "kafka", "cypress"],    // service 명칭으로 실행하는 방식
  "runServices": ["workspace", "postgres"], // 생략 시, workspace(devcontainer - main) 만 실행됨
  "workspaceFolder": "/home/vscode/${localWorkspaceFolderBasename}",

  // Featuring - 프론트엔드 + 백엔드 통합
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers-extra/features/projen:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/python:1": {
      // "version": "3.14"  // 너무 최신 버전이라 일치하는 MCP 가 없음
      "version": "3.12"
    },
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },

  // Custom - 확장 프로그램 통합
  "customizations": {
    "vscode": {
      "extensions": [
        // 공통
        "github.vscode-github-actions",
        "PKief.material-icon-theme",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "wayou.vscode-todo-highlight",
        "mhutchie.git-graph",
        "ms-azuretools.vscode-docker",
        "ms-vscode.vscode-typescript-next",
        // Python Extension for development
        "ms-python.python",
        // AI assistants
        "openai.chatgpt",
        "anthropic.claude-code"
      ]
    },
    "jetbrains": {
      "backend": "IntelliJ"
    }
  },
  // LifeCycles
  "initializeCommand": "bash ./.devcontainer/commands/initializeCommand.sh ${localWorkspaceFolder} ${containerWorkspaceFolder} ${localWorkspaceFolderBasename} ${containerWorkspaceFolderBasename}",
  "postCreateCommand": "bash ./.devcontainer/commands/postCommand.sh"
  // "postStartCommand": "bash ./.devcontainer/commands/startServices.sh"   // profiles 명칭으로 실행하는 방식
}
