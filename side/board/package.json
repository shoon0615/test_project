{
  "devDependencies": {
    "@types/node": "22.20.7",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "5.8.3",
    "vite": "^8.4.0"
  },
  "name": "board",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.server.json && tsc && vite build",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc",
    "start": "npm run build && node dist/server.js",
    "test": "npm run build && node --test server.test.mjs",
    "dev": "vite",
    "dev:api": "node --watch src/server.ts"
  },
  "private": true,
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  }
}
